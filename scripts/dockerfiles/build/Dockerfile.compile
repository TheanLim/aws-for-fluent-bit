ARG BUILD_IMAGE
FROM ${BUILD_IMAGE}

# Ensure we're in the build directory
WORKDIR /tmp/fluent-bit/build/

# Release enabled by default
ARG RELEASE=On
# Debug disabled by default
ARG DEBUG=Off
# AddressSanitizer disabled by default (requires FLB_JEMALLOC=Off)
ARG SANITIZE_ADDRESS=Off

# Install valgrind-devel if DEBUG is enabled
RUN if [ "$DEBUG" = "On" ]; then \
      yum install -y valgrind-devel; \
    fi

# Build Fluent Bit with appropriate compiler flags based on DEBUG, RELEASE, and SANITIZE_ADDRESS arguments
# When SANITIZE_ADDRESS=On, jemalloc must be disabled (ASan provides its own allocator).
RUN JEMALLOC_SETTING=On; \
    VALGRIND_SETTING=${DEBUG}; \
    EXTRA_C_FLAGS=""; \
    if [ "$SANITIZE_ADDRESS" = "On" ]; then \
      JEMALLOC_SETTING=Off; \
      VALGRIND_SETTING=Off; \
      EXTRA_C_FLAGS="-fno-omit-frame-pointer -fno-optimize-sibling-calls"; \
    fi && \
    cmake \
    -DCMAKE_C_FLAGS="$EXTRA_C_FLAGS" \
    # always on
    -DFLB_SIMD=On \
    -DFLB_JEMALLOC=${JEMALLOC_SETTING} \
    -DFLB_TLS=On \
    -DFLB_HTTP_SERVER=On \
    -DFLB_IN_SYSTEMD=On \
    -DFLB_OUT_KAFKA=On \
    -DFLB_ARROW=On \
    # always off
    -DFLB_SHARED_LIB=Off \
    -DFLB_EXAMPLES=Off \
    # release only
    -DFLB_RELEASE=${RELEASE} \
    # debug only
    -DFLB_DEBUG=${DEBUG} \
    -DFLB_DEV=${DEBUG} \
    -DFLB_VALGRIND=${VALGRIND_SETTING} \
    -DFLB_TRACE=${DEBUG} \
    -DFLB_MTRACE=${DEBUG} \
    -DFLB_BACKTRACE=${DEBUG} \
    # sanitizer
    -DSANITIZE_ADDRESS=${SANITIZE_ADDRESS} \
    ..

# Compile using all available processors for faster builds
RUN make -j $(getconf _NPROCESSORS_ONLN)

# Install the compiled binary to the expected location
RUN install bin/fluent-bit /fluent-bit/bin/
